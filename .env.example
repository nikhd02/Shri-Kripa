# Shree Kripa Family Restaurant & Banquet — Environment Variables
# ---------------------------------------------------------------
# Copy this file to .env and fill in EVERY value before running.
# NEVER commit .env to version control (it is gitignored).
# NEVER paste passwords or secrets into chat messages.
# ---------------------------------------------------------------

# ── Database ────────────────────────────────────────────────────
# XAMPP MariaDB 10.4 runs on localhost:3306 by default.
# Create a dedicated database and user before running migrations:
#   CREATE DATABASE shreekripa CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'skapp'@'localhost' IDENTIFIED BY 'your_strong_password';
#   GRANT ALL PRIVILEGES ON shreekripa.* TO 'skapp'@'localhost';
#   FLUSH PRIVILEGES;
DATABASE_URL="mysql://skapp:your_strong_password@localhost:3306/shreekripa"

# ── Session ─────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-64-random-hex-chars-never-commit-this"

# ── App URL ─────────────────────────────────────────────────────
# Used for metadata and absolute URL generation.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Initial Admin Account ───────────────────────────────────────
# These are read by prisma/seed.ts to create the first admin user.
# Change the password immediately after first login.
# The seed script will refuse to run if these are not set.
ADMIN_EMAIL="admin@shreekripa.in"
ADMIN_PASSWORD="ReplaceWithStrongPassword123!"

# ── Email (Banquet Enquiry Notifications) ───────────────────────
# Uses Gmail SMTP via Nodemailer.
# Create a Google App Password (not your main password):
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
# Address that receives banquet enquiry notifications
ENQUIRY_NOTIFY_EMAIL="your-gmail@gmail.com"
