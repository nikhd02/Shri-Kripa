# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# reference files (menu photos etc.) — private, not committed
/reference/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only .env.example (template, no secrets) is committed
.env
.env.local
.env.*.local
*.db
*.sqlite

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
